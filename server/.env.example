# ---- Server ----
PORT=8080
NODE_ENV=production
# Absolute or relative path to the static frontend (the built app). Defaults to ../public
STATIC_DIR=../public
# Public origin used for CORS when the API is called cross-origin (leave same-origin blank)
CORS_ORIGIN=

# ---- PostgreSQL ----
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=agrosmart
DB_PASSWORD=change-me
DB_NAME=agrosmart
# Set to true only if your Postgres provider requires TLS (e.g. managed cloud DBs)
DB_SSL=false

# ---- Auth ----
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d

# ---- Seed admin (created on first `npm run seed` if no admin exists) ----
ADMIN_NATIONAL_ID=1199080000000000
ADMIN_PHONE=0788000000
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Admin

# ---- OpenAI (AI API KEY stays here on the server, never shipped to the app) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
