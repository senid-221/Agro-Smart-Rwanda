# ---- Server ----
PORT=8080
NODE_ENV=production
# Absolute or relative path to the static frontend (the built app). Defaults to ../public
STATIC_DIR=../public
# Public origin used for CORS when the API is called cross-origin (leave same-origin blank)
CORS_ORIGIN=

# ---- PostgreSQL / Neon ----
# Recommended: a Neon (serverless Postgres) pooled connection string. When set,
# DATABASE_URL wins over the discrete DB_* values below and TLS is enabled.
# Copy it from the Neon console (Connection Details → pooled connection string).
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# Discrete values used only when DATABASE_URL is blank (e.g. a local Postgres):
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=agrosmart
DB_PASSWORD=change-me
DB_NAME=agrosmart
# Set to true only if your Postgres provider requires TLS (e.g. managed cloud DBs)
DB_SSL=false

# ---- Auth ----
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d
# Google "Sign in with Google" (Google Identity Services). Create an OAuth client
# of type Web application in Google Cloud Console, add your site origin to the
# authorized JavaScript origins, and paste the Client ID here. It is public (it
# ships to the browser); the server uses it to verify the Google ID token.
# Leave blank to hide the Google button and run email+password only.
GOOGLE_CLIENT_ID=

# ---- Admin account ----
# Two ways to create the administrator:
#   1) CLI:  npm run create-admin -- <email> <password> [name]
#   2) Env (used on Render / any host without a shell): set ADMIN_EMAIL +
#      ADMIN_PASSWORD (>= 8 chars). The server ensures this admin on every boot
#      (idempotent; it never overwrites a password changed later in-app).
# Leave ADMIN_* blank if you prefer the CLI.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Legacy optional identifiers (still accepted for an existing admin login):
ADMIN_NATIONAL_ID=
ADMIN_PHONE=

# ---- OpenAI (AI API KEY stays here on the server, never shipped to the app) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Vision-capable model for Crop AI Doctor photo analysis. Defaults to OPENAI_MODEL
# if blank; set to a vision model (e.g. gpt-4o) if your chat model cannot see images.
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Crop Doctor web research (OPTIONAL) ----
# Grounded RAB / offline knowledge is always primary. A live web-search provider
# is used only when its key is set; results are ranked by source authority and
# cited. Leave TAVILY_API_KEY blank to run knowledge-base-only (no live research).
RESEARCH_PROVIDER=tavily
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
RESEARCH_MAX_RESULTS=5

# ---- Password-reset OTP policy (seconds / counts) ----
# Codes are generated server-side and shown in the app (no SMS provider).
OTP_TTL_SEC=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SEC=30
RESET_TOKEN_TTL_SEC=600
