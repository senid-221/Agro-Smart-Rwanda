# ---- Server ----
PORT=8080
NODE_ENV=production
# Absolute or relative path to the static frontend (the built app). Defaults to ../public
STATIC_DIR=../public
# Public origin used for CORS when the API is called cross-origin (leave same-origin blank)
CORS_ORIGIN=

# ---- PostgreSQL ----
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=agrosmart
DB_PASSWORD=change-me
DB_NAME=agrosmart
# Set to true only if your Postgres provider requires TLS (e.g. managed cloud DBs)
DB_SSL=false

# ---- Auth ----
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d

# ---- Admin account ----
# No admin is created by `npm run seed`. Create one explicitly instead:
#   npm run create-admin -- <nationalId> <phone> <password> [name]
# The values below are OPTIONAL fallbacks read by `create-admin` when no CLI
# args are passed. Leave them blank and pass real values on the command line.
ADMIN_NATIONAL_ID=
ADMIN_PHONE=
ADMIN_PASSWORD=
ADMIN_NAME=

# ---- OpenAI (AI API KEY stays here on the server, never shipped to the app) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Africa's Talking SMS (delivers "Forgot password" OTP codes) ----
# Create an app at https://account.africastalking.com, then use its username + API key.
AT_USERNAME=
AT_API_KEY=
# Optional registered short code / sender ID (leave blank to use the sandbox default)
AT_SENDER_ID=
AT_API_URL=https://api.africastalking.com/version1/messaging

# ---- Password-reset OTP policy (seconds / counts) ----
OTP_TTL_SEC=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SEC=30
RESET_TOKEN_TTL_SEC=600
